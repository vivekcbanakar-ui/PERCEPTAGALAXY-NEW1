generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  name                  String?
  createdAt             DateTime   @default(now())
  
  planTier              String     @default("free")
  subscriptionId        String?    @unique
  subscriptionStatus    String?
  
  razorpayCustomerId    String?    @unique
  razorpaySubscriptionId String?   @unique
  
  stripeCustomerId      String?    @unique
  stripeSubscriptionId  String?    @unique
  
  maxCompetitors        Int        @default(5)
  usedCompetitors       Int        @default(0)
  
  apiKey                String     @unique @default(cuid())
  apiKeyRotatedAt       DateTime   @default(now())
  
  lastLoginAt           DateTime?
  competitors           Competitor[]
  alerts                AlertLog[]
  scraperJobs           ScraperJob[]
  auditLogs             AuditLog[]
}

model Competitor {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name              String
  website           String
  
  lastScrapeAt      DateTime?
  nextScrapeAt      DateTime?
  
  data              Json?
  previousData      Json?
  
  insights          String?
  strategy          String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  alerts            AlertLog[]
  scraperJobs       ScraperJob[]
  
  @@unique([userId, name])
}

model AlertLog {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  competitorId      String
  competitor        Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  
  type              String
  description       String
  severity          String
  
  sentVia           String[] @default([])
  readAt            DateTime?
  
  createdAt         DateTime  @default(now())
}

model ScraperJob {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  competitorId      String
  competitor        Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  
  apifyRunId        String?   @unique
  status            String
  
  results           Json?
  error             String?
  
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
}

model AuditLog {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action            String
  details           Json
  ipAddress         String?
  userAgent         String?
  
  createdAt         DateTime  @default(now())
}

model RazorpayOrder {
  id                String    @id @default(cuid())
  orderId           String    @unique
  
  userId            String
  planTier          String
  amount            Int
  currency          String    @default("INR")
  
  status            String
  receiptId         String?
  
  notes             Json?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model RazorpayPayment {
  id                String    @id @default(cuid())
  paymentId         String    @unique
  orderId           String
  
  status            String
  amount            Int
  
  method            String
  email             String?
  contact           String?
  
  metadata          Json?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
